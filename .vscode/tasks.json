{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "dotnet: build",
			"command": "dotnet",
			"type": "shell",
			"args": [
				"build",
				"-clp:NoSummary",
				"${workspaceFolder}/${workspaceFolderBasename}/Heron.csproj"
			],
			"problemMatcher": "$msCompile",
			"presentation": {
				"reveal": "always",
				"clear": true
			},
			"group": "build"
		}
	]
}