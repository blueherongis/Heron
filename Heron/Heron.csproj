<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Select the framework(s) you wish to target.
        Rhino 6: net45
        Rhino 7: net48
        Rhino 8 Windows: net48, net7.0, net7.0-windows, net7.0-windows10.0.22000.0, etc
        Rhino 8 Mac: net7.0, net7.0-macos, net7.0-macos12.0, etc
    -->
		<TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<TargetExt>.gha</TargetExt>
		<NoWarn>NU1701;NETSDK1086</NoWarn>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<LangVersion>12.0</LangVersion>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Specifies information for Assembly and Yak -->
		<Version>1.0</Version>
		<Title>Heron</Title>
		<Company>Heron Authors</Company>
		<Description>Description of Heron</Description>
	</PropertyGroup>

	<!-- For Windows only builds -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4'))">
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<!-- Reference WinForms for .NET 7.0 on macOS -->
	<ItemGroup Condition="!($(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4')))">
		<!-- Rhino 8.11 and later you can use this -->
		<!-- <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" /> -->

		<!-- Rhino 8.10 and earlier -->
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" ExcludeAssets="all" GeneratePathProperty="true" />
		<Reference Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)\build\.NETFramework\v4.8\System.Windows.Forms.dll" Private="False" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.0" ExcludeAssets="runtime" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Disables the persistent compiler server that locks files -->
		<UseSharedCompilation>false</UseSharedCompilation>
		
		<!-- Set a default or base folder suffix -->
		<PlatformFolder Condition="$([MSBuild]::IsOSPlatform('Windows'))">win</PlatformFolder>
		<PlatformFolder Condition="$([MSBuild]::IsOSPlatform('OSX'))">mac</PlatformFolder>

		<!-- Append the folder to the existing OutputPath -->
		<OutputPath>$([MSBuild]::NormalizeDirectory('$([System.IO.Path]::Combine('$(ProjectDir)', 'Heron', 'bin', '$(Configuration)', '$(PlatformFolder)'))'))</OutputPath>
		<!-- <OutputPath>$(ProjectDir)bin\$(Configuration)\$(PlatformFolder)\</OutputPath> -->

		<!-- Clean up the path (optional but recommended) -->
		<!-- Prevents nesting like bin/win/net48/ so Yak finds your files easily -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<!-- This tells the debugger where to start the process -->
		<StartWorkingDir>$(OutputPath)</StartWorkingDir>

		<!-- Path to Rhino - Adjust version if necessary -->
		<StartAction>Program</StartAction>
		<StartProgram Condition="$([MSBuild]::IsOSPlatform('Windows'))">C:\Program Files\Rhino 8\System\Rhino.exe</StartProgram>
		<StartProgram Condition="$([MSBuild]::IsOSPlatform('OSX'))">/Applications/Rhino 8.app/Contents/MacOS/Rhinoceros</StartProgram>
	</PropertyGroup>

	<Target Name="BuildYakPackage" AfterTargets="DispatchToInnerBuilds" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<YakExecutable Condition="$(YakExecutable) == '' and $([MSBuild]::IsOSPlatform(windows)) and Exists('C:\Program Files\Rhino 8\System\Yak.exe')">C:\Program Files\Rhino 8\System\Yak.exe</YakExecutable>
			<YakExecutable Condition="$(YakExecutable) == '' and $([MSBuild]::IsOSPlatform(macos)) and Exists('/Applications/Rhino 8.app/Contents/Resources/bin/yak')">/Applications/Rhino 8.app/Contents/Resources/bin/yak</YakExecutable>

			<BuildYakPackage Condition="$(BuildYakPackage) == '' and $(YakExecutable) != '' and Exists($(YakExecutable))">True</BuildYakPackage>
		</PropertyGroup>

		<Warning Text="Could not find Yak executable" Condition="$(YakExecutable) == ''" />

		<ItemGroup>
			<YakPackagesToDelete Include="$(OutputPath)\*.yak;$(OutputPath)\**\manifest.yml" />
		</ItemGroup>

		<Delete Files="@(YakPackagesToDelete)" />

		<Exec Command="&quot;$(YakExecutable)&quot; spec" WorkingDirectory="$(OutputPath)" Condition="$(BuildYakPackage) == 'True'" />
		<Exec Command="&quot;$(YakExecutable)&quot; build --platform $(PlatformFolder)" WorkingDirectory="$(OutputPath)" Condition="$(BuildYakPackage) == 'True'" />

	</Target>

	<!-- Nuget Packages-->
