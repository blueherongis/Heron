	<!-- Ensure availability of Geoid file-->
	<Target Name="DownloadGeoidFile" AfterTargets="Build">
		<!-- Define the source URL as a property. This avoids large gtx files being checked into source control -->
		<PropertyGroup>
			<GeoidUrl>https://github.com/OSGeo/proj-datumgrid/raw/refs/heads/master/world/egm08_25.gtx</GeoidUrl>
			<TargetGtxPath>$(OutputPath)gdal\share\egm08_25.gtx</TargetGtxPath>
		</PropertyGroup>
		<!-- Ensure the directory exists first -->
		<MakeDir Directories="$(OutputPath)gdal\share" Condition="!Exists('$(OutputPath)gdal\share')" />
		<!-- Use a condition to check for file existence -->
		<Exec Command="powershell -Command &quot;Invoke-WebRequest -Uri '$(GeoidUrl)' -OutFile '$(TargetGtxPath)'&quot;" Condition="!Exists('$(TargetGtxPath)') And '$(OS)' == 'Windows_NT'" />
		<Exec Command="curl -LJo $(TargetGtxPath) $(GeoidUrl)" Condition="!Exists('$(TargetGtxPath)') And '$(OS)' != 'Windows_NT'" />
	</Target>
	<!-- End ensure availability of Geoid file-->

